{
  "name": "lyric-player",
  "productName": "Lyric Player",
  "version": "1.0.0",
  "description": "Time-synced lyrics for whatever is playing on Spotify – desktop app for Windows and macOS",
  "main": "src/main/main.js",
  "spotifyClientId": "51715cf594564f33913154646b7f9555",
  "author": "Kavin Lokeswaran",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "icon": "electron scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "no.kavinlokeswaran.lyricplayer",
    "productName": "Lyric Player",
    "copyright": "Kavin Lokeswaran",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Lyric Player leser hvilken sang som spilles i Spotify, så den kan vise riktige lyrics."
      }
    },
    "dmg": {
      "title": "Lyric Player"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lyric Player"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  }
}
